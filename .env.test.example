# Projeto Supabase SÓ DE TESTES (TEST-001). Copie para .env.test.local e preencha.
# O e2e e os testes de integração usam este projeto; a produção (.env.local) nunca recebe fixtures.
# Depois de preencher: npm run test:db:setup   (migrations + contas de teste + cópia do conteúdo público)

# Supabase → Project Settings → API (ou Data API / API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://<ref-do-projeto-de-testes>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase → Project Settings → Database (senha definida ao criar o projeto)
SUPABASE_PROJECT_REF=<ref-do-projeto-de-testes>
SUPABASE_DB_PASSWORD=
# Botão "Connect" → Session pooler (IPv4). Deixe ${SUPABASE_DB_PASSWORD} literal no lugar da senha.
SUPABASE_DB_URL=postgresql://postgres.<ref-do-projeto-de-testes>:${SUPABASE_DB_PASSWORD}@aws-<n>-sa-east-1.pooler.supabase.com:5432/postgres

# Preenchidas por npm run test:db:setup (não edite à mão)
# E2E_ADMIN_EMAIL= E2E_ADMIN_PASSWORD= E2E_REVIEWER_EMAIL= E2E_REVIEWER_PASSWORD= E2E_MEMBER_EMAIL= E2E_MEMBER_PASSWORD=
