# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright
/test-results/
/playwright-report/
/playwright/.cache/

# baseline visual (regenerar com `npm run baseline:screenshots`)
/docs/baseline/screenshots/

# credenciais Google (OAuth/conta de serviço) — nunca no repositório
/secrets/
client_secret*.json
google-oauth*.json
*-service-account*.json

# scripts de sessão do operador (nunca commitar)
/_*.mjs
/_*.mts
