# Copie para .env.local. Sem estas variáveis o Portal falha fechado (503) e o site público funciona normalmente.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Domínio público (canonical/hreflang/sitemap absolutos)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Quarentena editorial: review (default, exibe selo) | strict (oculta conteúdo não verificado)
NEXT_PUBLIC_CONTENT_MODE=review

# Somente servidor/CI — nunca no cliente
SUPABASE_SERVICE_ROLE_KEY=
# Segredo do HMAC que anonimiza a origem do formulário Tenho um desafio (fallback: service role key)
CHALLENGE_HASH_SECRET=
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
# Conexão para db:push (session pooler IPv4: postgresql://postgres.<ref>:${SUPABASE_DB_PASSWORD}@aws-<n>-<região>.pooler.supabase.com:5432/postgres)
SUPABASE_DB_URL=

# E-mail transacional (MAIL-001) — sem estas variáveis a fila fica em `queued` e nada se perde
RESEND_API_KEY=
# Remetente com domínio verificado no Resend, ex.: "Curso <no-reply@exemplo.ufsc.br>"
MAIL_FROM=
MAIL_REPLY_TO=
# Segredo do endpoint POST /api/mail/dispatch (cron); sem ele a rota responde 404
MAIL_DISPATCH_SECRET=
# Usuários de teste para o E2E autenticado (opcional)
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
# Segunda conta (coordenação) para o fluxo de aprovação por terceiro
E2E_REVIEWER_EMAIL=
E2E_REVIEWER_PASSWORD=
